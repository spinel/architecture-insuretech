        <!-- Comments and Annotations -->
        <mxCell id="comment1" value="Стратегия масштабирования:&#xa;• Горизонтальное масштабирование через Kubernetes HPA&#xa;• Вертикальное масштабирование через VPA&#xa;• Автоматическое масштабирование на основе метрик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;" vertex="1" parent="1">
