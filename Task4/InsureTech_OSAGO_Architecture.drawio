          <mxGeometry x="350" y="560" width="50" height="30" as="geometry" />
        </mxCell>

        <!-- Kafka Cluster -->
        <mxCell id="kafka-cluster" value="Apache Kafka Cluster&#xa;&#xa;Topics:&#xa;• insurance.products.updated&#xa;• insurance.policies.created&#xa;• insurance.settlements.required&#xa;• insurance.companies.status&#xa;• osago.offers.received (NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="600" y="340" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Redis Cache -->
        <mxCell id="redis1a" value="Redis Cache&#xa;(Yandex Managed Redis)&#xa;&#xa;• tariffs:{company_id}&#xa;• tariffs:all&#xa;• companies:status&#xa;• osago_cache:{vin} (NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="550" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Database -->
        <mxCell id="db-cluster1" value="PostgreSQL Cluster&#xa;(Yandex Managed PostgreSQL)&#xa;&#xa;Primary: AZ 1A&#xa;Standby: AZ 1B&#xa;Read Replica: AZ 1C&#xa;&#xa;+ Outbox Tables&#xa;+ osago_applications (NEW)&#xa;+ osago_offers (NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="300" y="650" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- External Services -->
        <mxCell id="external-services" value="Внешние сервисы&#xa;&#xa;10 страховых компаний&#xa;OSAGO APIs (NEW)&#xa;SMS/Email провайдеры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
