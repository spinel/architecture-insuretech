          <mxGeometry x="320" y="460" width="50" height="40" as="geometry" />
        </mxCell>

        <mxCell id="settlement1a" value="ins-comp-settlement&#xa;(Event Consumer + Publisher)&#xa;1 replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="380" y="460" width="50" height="40" as="geometry" />
        </mxCell>

        <!-- New OSAGO Services -->
        <mxCell id="osago-aggregator1a" value="osago-aggregator&#xa;(NEW SERVICE)&#xa;5-10 replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="320" y="510" width="50" height="40" as="geometry" />
        </mxCell>

        <mxCell id="settlement-processor1a" value="Settlement Processor&#xa;(Event Consumer)&#xa;2 replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="380" y="510" width="50" height="40" as="geometry" />
